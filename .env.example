# TravelMateNE — Environment Configuration Reference
# Copy this file to .env (or backend/.env) and populate the values if desired.
# All values are optional: TravelMateNE functions out of the box with its offline curated engine!

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration (Optional: uses high-performance offline JSON fallback if omitted)
# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
DATABASE_NAME=travelmatene

# AI Travel Planner (Optional: uses curated Northeast rule-based generator fallback if omitted)
# Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=

# Security & Authentication
JWT_SECRET=travelmatene-production-secret-key-change-me
CORS_ORIGINS=*
